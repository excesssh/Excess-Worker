{
  "name": "excess-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.11.1",
    "npm": "11.7.0"
  },
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "apps/worker",
    "packages/adapters",
    "packages/protocol"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "npm run build && node --test --test-concurrency=4 tests/*.test.mjs",
    "package:worker": "npm run build && node scripts/package-worker.mjs",
    "privacy": "node scripts/public-worker/privacy.mjs --history",
    "setup:project": "node scripts/public-worker/setup-project.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
